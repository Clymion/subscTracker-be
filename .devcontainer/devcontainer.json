{
    "name": "SubscTracker Backend",
    "dockerComposeFile": [
        "../compose.yml",
        "docker-compose.yml"
    ],
    "service": "backend-api",
    "workspaceFolder": "/workspace",
    "overrideCommand": false,
    "containerEnv": {
        "SHELL": "/bin/bash"
    },
    "remoteUser": "root",
    // Claude Codeをインストール
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "lts"
        }
    },
    "remoteEnv": {
        "ANTHROPIC_BASE_URL": "https://openrouter.ai/api",
        "ANTHROPIC_AUTH_TOKEN": "${localEnv:OPENROUTER_API_KEY}",
        "ANTHROPIC_API_KEY": "",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "z-ai/glm-5-turbo",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "z-ai/glm-5",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "moonshotai/kimi-k2.5"
    },
    "postCreateCommand": "npm install -g @anthropic-ai/claude-code && npx --yes cc-sdd@latest --lang ja",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.black-formatter",
                "streetsidesoftware.code-spell-checker",
                "mhutchie.git-graph",
                "GitHub.copilot",
                "yzhang.markdown-all-in-one",
                "PKief.material-icon-theme",
                "christian-kohler.path-intellisense",
                "Gruntfuggly.todo-tree",
                "charliermarsh.ruff",
                "ms-vscode.test-adapter-converter",
                "humao.rest-client",
                "GitHub.vscode-pull-request-github",
                "hbenl.vscode-test-explorer",
                "bierner.markdown-mermaid",
                "tamasfe.even-better-toml",
                "ms-vscode.makefile-tools"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.linting.enabled": true,
                "python.linting.pylintEnabled": true,
                "python.formatting.provider": "black",
                "python.formatting.blackPath": "/usr/local/bin/black"
            }
        }
    }
}
